{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MDVibe",
  "mainBinaryName": "MDVibe",
  "version": "../package.json",
  "identifier": "digital.satyr.mdvibe",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build:web",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: http://mdimg.localhost mdimg: https: http:",
        "font-src": "'self' data:",
        "connect-src": "ipc: http://ipc.localhost https://api.github.com",
        "worker-src": "'self'",
        "frame-src": "'none'",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'"
      },
      "freezePrototype": true,
      "dangerousDisableAssetCspModification": false
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "Satyr Digital",
    "copyright": "Copyright © 2026 Andrii Shumak",
    "homepage": "https://satyr.digital",
    "category": "Productivity",
    "shortDescription": "Fast, clean Markdown viewer",
    "longDescription": "MDVibe is a fast, privacy-friendly Markdown viewer. Every document opens in its own window.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "icons/md-document.ico": "md-document.ico",
      "../../../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md"
    },
    "windows": {
      "allowDowngrades": false,
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "installerHooks": "nsis/hooks.nsh",
        "compression": "lzma",
        "displayLanguageSelector": false,
        "headerImage": "nsis/header.bmp",
        "sidebarImage": "nsis/sidebar.bmp"
      },
      "signCommand": {
        "cmd": "powershell",
        "args": [
          "-NoProfile",
          "-ExecutionPolicy",
          "Bypass",
          "-File",
          "../../scripts/sign.ps1",
          "%1"
        ]
      }
    }
  }
}
